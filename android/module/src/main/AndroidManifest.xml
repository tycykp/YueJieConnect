<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <package android:name="com.milink.service" />
        <package android:name="com.oplus.linker" />
        <package android:name="com.xiaomi.mirror" />
        <package android:name="com.coloros.findmyphone" />
        <package android:name="com.oplus.cast" />
        <package android:name="com.heytap.accessory" />
    </queries>
    <application android:label="@string/app_name" android:description="@string/module_description"
        android:icon="@drawable/ic_launcher" android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".BridgeBootstrapActivity" android:exported="true" android:process=":bridge"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Each transaction validates UID, PID, package, version, certificate and Rust session.
             Network starts from the module or verified OEM pairing UI, with bilateral confirmation. -->
        <service android:name=".BridgeService" android:exported="true" android:process=":bridge" android:foregroundServiceType="connectedDevice" />
        <activity android:name=".CameraShareConsentActivity" android:exported="false" android:process=":bridge" />
        <service android:name=".CameraShareSourceService" android:exported="false" android:process=":bridge" android:foregroundServiceType="camera" />
        <service android:name=".NotificationSyncListener" android:exported="true" android:process=":bridge"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <receiver android:name=".NotificationSyncActionReceiver" android:exported="false" android:process=":bridge" />
    </application>
</manifest>
